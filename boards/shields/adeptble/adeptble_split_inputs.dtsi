#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        adeptble_trackball_split: adeptble_trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };

        adeptble_buttons_split: adeptble_buttons_split@1 {
            compatible = "zmk,input-split";
            reg = <1>;
        };
    };

    adeptble_trackball_listener: adeptble_trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&adeptble_trackball_split>;
        input-processors = <&zip_xy_swap_mapper>;

        scroll {
            layers = <3>;
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT)>,
                               <&zip_xy_swap_mapper>,
                               <&zip_xy_scaler 1 10>,
                               <&zip_xy_to_scroll_mapper>;
            process-next;
        };

        snipe {
            layers = <4>;
            input-processors = <&zip_xy_scaler 1 5>;
            process-next;
        };
    };

    adeptble_buttons_listener: adeptble_buttons_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&adeptble_buttons_split>;
    };
};
