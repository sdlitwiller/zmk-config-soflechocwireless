#include <dt-bindings/zmk/matrix_transform.h>
#include <layouts/josefadamcik/sofle.dtsi>
#include "../adeptble/adeptble_split_inputs.dtsi"

&josefadamcik_sofle_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &josefadamcik_sofle_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8)  RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8)  RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                 RC(2,6) RC(2,7) RC(2,8)  RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(4,5) RC(4,6) RC(3,6) RC(3,7) RC(3,8)  RC(3,9) RC(3,10) RC(3,11)
                RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-mock";
        events = <>;
    };
};

/* Disable the board's default CDC-ACM console UART so only the Studio RPC
 * UART is exposed. Without this the XIAO BLE presents two CDC-ACM interfaces
 * and macOS shows four serial ports (tty+cu for each), filling ZMK Studio's
 * device picker with duplicates. */
&board_cdc_acm_uart {
    status = "disabled";
};

/* The board's chosen zephyr,console (and related) still points to
 * board_cdc_acm_uart which is now disabled, causing uart_console.c to fail
 * to compile because no device struct is generated for a disabled node.
 * For the regular build, redirect to the Studio RPC UART.
 * For the settings_reset build, remove the console chosen entirely since
 * no USB console is needed. */
#ifdef BLE_CENTRAL_HUB_SETTINGS_RESET
/ {
    chosen {
        /delete-property/ zephyr,console;
        /delete-property/ zephyr,shell-uart;
        /delete-property/ zephyr,uart-mcumgr;
        /delete-property/ zephyr,bt-mon-uart;
        /delete-property/ zephyr,bt-c2h-uart;
    };
};
#else
/ {
    chosen {
        zephyr,console = &snippet_studio_rpc_usb_uart;
        zephyr,shell-uart = &snippet_studio_rpc_usb_uart;
        zephyr,uart-mcumgr = &snippet_studio_rpc_usb_uart;
        zephyr,bt-mon-uart = &snippet_studio_rpc_usb_uart;
        zephyr,bt-c2h-uart = &snippet_studio_rpc_usb_uart;
    };
};
#endif

&adeptble_trackball_listener {
    status = "okay";
};

&adeptble_buttons_listener {
    status = "okay";
};
